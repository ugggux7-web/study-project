#include <iostream>
using namespace std;
void draw_triangle(int line);

int main() {
    int n,line;
    cin >> n;
    line = n;
    draw_triangle(line);
    return 0;
}
void draw_triangle(int line) {
    int j;
    for (int i = line - 1; i >= 0;i--) {
        j = line - i;
        for (int k = 0;k < i;k++) {
            cout << ' ';
        }
        for (int m = 0;m < j;m++) {
            cout << '*';
        }
        cout << endl;
    }
}
